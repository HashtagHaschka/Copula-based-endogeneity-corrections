## --- the augmented-regression estimators -------------------------------------

coef(object = ex1)
vcov(object = ex1)                              # bootstrap covariance matrix
nobs(object = ex1)
formula(x = ex1)
confint(object = ex1, parm = names(coef(object = ex1)), level = 0.95,
        type = "normal")
confint(object = ex1, parm = names(coef(object = ex1)), level = 0.95,
        type = "percentile")
confint(object = ex1, parm = "lprice", level = 0.99, type = "percentile")

residuals(object = ex1, type = "structural")    # xi = y - mu - P a - W b
residuals(object = ex1, type = "augmented")     # u = xi - C gamma
fitted(object = ex1, type = "structural")       # mu + P a + W b
fitted(object = ex1, type = "augmented")
predict(object = ex1, newdata = head(dat3, 5))  # structural model only

ex1$rho                               # corr(xi*, P*) per endogenous regressor
ex1$rho.se
ex1$ols.coefficients                  # uncorrected benchmark, same resamples
ex1$ols.std.error
ex1$icon
ex1$boot                              # raw B x k bootstrap draws

ex1$diagnostics$nonnormality
ex1$diagnostics$exog.correlation
ex1$diagnostics$exog.correlation.matrix
ex1$diagnostics$collinearity

summary(object = ex1)$wald            # joint Wald test of the copula terms
summary(object = ex2)$wald.z          # do they differ across the categories?
ex2$copula.groups                     # which copula column belongs to which cell

v <- validity(object = ex1, level = 0.05, power = 0.8)
v$step1                               # nonnormality, Becker and Yang criteria
v$step2$violated                      # the uncorrelatedness assumption
v$step3                               # identifying variation in W
v$step4                               # error term
v$icon


## --- the Bayesian class ------------------------------------------------------
##
##  The same generics, reading a posterior instead of a bootstrap distribution:
##  coef() is the posterior mean, vcov() the posterior covariance, confint() a
##  credible interval taken from the draws themselves rather than from a normal
##  approximation to them.  There is no type = here, because there is only one
##  kind of interval, and residuals() has no type = either, because there is no
##  augmented regression.

coef(object = ex3)
ex3$posterior.median
ex3$std.error                         # posterior standard deviation
vcov(object = ex3)
nobs(object = ex3)
formula(x = ex3)
confint(object = ex3, parm = names(coef(object = ex3)), level = 0.95)
confint(object = ex3, parm = "lprice", level = 0.99)
fitted(object = ex3)
residuals(object = ex3)
predict(object = ex3, newdata = head(dat3, 5))

ex3$draws                             # every parameter, one column each
ex3$coefficient.draws
ex3$sigma2.draws
ex3$Sigma.draws                       # including the structural zeros
ex3$Sigma.free                        # which of those columns are free
ex3$lambda.draws                      # the probability masses, per regressor
ex3$margins                           # the unique values they sit on
ex3$acceptance
ex3$ndraws
ex3$iterations; ex3$burnin; ex3$thin
ex3$horseshoe
ex3$prior.args


