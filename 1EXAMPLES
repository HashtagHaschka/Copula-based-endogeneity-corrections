                    ncores    = NULL,
                    verbose   = interactive())

pan9 <- CopRegPANEL(formula   = logmove ~ price4 | price4:feat + price1 + feat,
                    data      = dat5,
                    index     = c("store", "week"),
                    cdf       = "kde.plugin",
                    ties      = "max",
                    intercept = FALSE,
                    nboots    = 99,
                    method    = "BFGS",
