                      nboots        = 99,
                      subset        = NULL,
                      contrasts     = NULL,
                      parallel      = FALSE,
                      ncores        = NULL,
                      verbose       = interactive())

## demean = treats the categories as fixed effects and sweeps them out of P and
## the continuous conditioning variables before the first step (Section 3.1.5,
## for clustered data whose categorical variables are too many to smooth and
## too fine to group by).
np4 <- CopReg2sCOPEnp(formula       = lsales ~ lprice |
