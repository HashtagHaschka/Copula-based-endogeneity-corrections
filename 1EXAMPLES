ex1 <- CopRegPG(formula   = lsales ~ lprice + lcompprice |
                            Income + Advertising + Age,
                data      = dat3,
                cdf       = "kde.silverman",
                ties      = "max",
                nboots    = 199,
                subset    = NULL,
                contrasts = NULL,
                parallel  = FALSE,
                ncores    = NULL,
                verbose   = interactive())

ex2 <- CopRegJAMS(formula     = lsales ~ lprice + lcompprice |
                                ShelveLoc + Income + Advertising + Age,
                  data        = dat3,
                  conditional = "ShelveLoc",
                  cdf         = "ecdf.adj",
                  ties        = "max",
                  nboots      = 199,
                  subset      = NULL,
                  contrasts   = NULL,
                  parallel    = FALSE,
                  ncores      = NULL,
                  verbose     = interactive())

ex3 <- CopRegBAYES(formula    = lsales ~ lprice + lcompprice |
                                Income + Advertising + Age,
                   data       = dat3,
                   iterations = 20000,
                   burnin     = 2000,
                   thin       = 20,
                   horseshoe  = TRUE,
                   prior.args = list(),
                   start      = NULL,
                   subset     = NULL,
                   contrasts  = NULL,
