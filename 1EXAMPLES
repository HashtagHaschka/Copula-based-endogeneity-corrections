## -----------------------------------------------------------------------------
##  Setup
## -----------------------------------------------------------------------------
##  This is the only file you need.  The estimators are read straight from
##  GitHub, so there is nothing else to download and no working directory to
##  set: run the block below and everything is in place.

gh <- paste0("https://raw.githubusercontent.com/HashtagHaschka/",
             "Copula-based-endogeneity-corrections/functions/")

for (f in c("Copreg_core.R",        # the core has to come first
            "Copreg_pg.R",
            "Copreg_2scope.R",
            "Copreg_ima.R",
            "Copreg_jams.R",
            "Copreg_bmw.R",
            "Copreg_2scope_np.R",
            "Copreg_panel.R",
            "Copreg_bayes.R"))
  source(paste0(gh, f))

## The estimators themselves need Formula, and 2sCOPE-np additionally needs np.
## The examples below use three data packages.
need <- c("Formula",                 # required by every estimator
          "np",                      # required by 2sCOPE-np only
          "bayesm", "AER", "ISLR")   # the data used in the examples
miss <- need[!vapply(need, requireNamespace, logical(1), quietly = TRUE)]
if (length(miss) > 0L) install.packages(miss)


## The interface at a glance
## -------------------------
##  CopRegPG      (formula, data, cdf, ties, nboots, subset, contrasts,
##                 parallel, ncores, verbose)
##  CopReg2sCOPE  (as PG)
##  CopRegIMA     (as PG)
##  CopRegBMW     (as PG)
##  CopRegJAMS    (as PG, plus conditional)
##  CopReg2sCOPEnp(formula, data, condition, groups, heterogeneous, demean,
##                 bwmethod, bw.refit, nboots, subset, contrasts, parallel,
##                 ncores, verbose, ...)
##  CopRegPANEL   (formula, data, index, cdf, ties, intercept, nboots, method,
##                 start, maxit, subset, contrasts, parallel, ncores, verbose)
##  CopRegBAYES   (formula, data, iterations, burnin, thin, horseshoe,
##                 prior.args, start, subset, contrasts, verbose)
##  copreg        (formula, data, method, cdf, ...)
##
##  cdf defaults to the estimator's own paper: "kde.silverman" for Park &
##  Gupta (2012), "rank.n" for 2sCOPE (Yang, Qian & Xie 2025) and for IMA
##  (Haschka 2025), "ecdf.adj" for JAMS, "rank.n1" for BMW, "kde.plugin" for
##  PANEL.  The seven choices are "kde.silverman", "kde.cv", "kde.plugin",
##  "ecdf.fixed", "ecdf.adj", "rank.n" and "rank.n1".
##
##  Two estimators have no cdf and no ties.  2sCOPE-np builds its copula term
##  from the conditional CDF of P given W, estimated nonparametrically, so
##  there is no marginal CDF to choose; see section 5.  BAYES treats the
##  marginal CDFs as parameters and replaces the bootstrap by a posterior, so
##  it has no nboots either; see section 6.  PANEL is a separate model class
##  needing an index; see section 7.
##
##  Extractors, section 8:
##    summary(mod)   coefficients, endogeneity measure, diagnostics
##    validity(mod)  the decision tree of Yang, Qian & Xie (2025, Fig. 2), the
##                   boundary conditions of Becker, Proksch & Ringle (2022,
##                   Fig. 8) and the ICON statistic
##    residuals(mod) structural residuals xi = y - mu - P alpha - W beta
##
##  Nothing in the toolbox sets a seed at any point.


## =============================================================================
##  1. Orange juice (Dominick's), Tropicana
## =============================================================================

library(bayesm)
data("orangeJuice")
dat1 <- orangeJuice[[1]]

dat1_Tropicana <- dat1[dat1$brand == 4, ]
pcols <- grep("^price", names(dat1_Tropicana), value = TRUE)
dat1_Tropicana[pcols] <- lapply(dat1_Tropicana[pcols], log)

f1 <- logmove ~ price4 |
  price1 + price2 + price3 + price5 + price6 + price7 + price8 + price9 +
  price10 + feat + as.factor(deal)


## --- price4 endogenous, competing prices and promotion as controls -----------

mod1 <- CopRegPG(formula   = f1,
                 data      = dat1_Tropicana,
                 cdf       = "kde.silverman",
                 ties      = "max",
                 nboots    = 199,
                 subset    = NULL,
                 contrasts = NULL,
                 parallel  = FALSE,
                 ncores    = NULL,
                 verbose   = interactive())
summary(object = mod1)
validity(object = mod1, level = 0.05, power = 0.8)
hist(residuals(object = mod1, type = "structural"), breaks = 40,
     main = "mod1", xlab = expression(hat(xi)))

mod2 <- CopReg2sCOPE(formula   = f1,
                     data      = dat1_Tropicana,
                     cdf       = "rank.n",
                     ties      = "max",
                     nboots    = 199,
                     subset    = NULL,
                     contrasts = NULL,
                     parallel  = FALSE,
                     ncores    = NULL,
                     verbose   = interactive())
summary(object = mod2)
validity(object = mod2, level = 0.05, power = 0.8)
hist(residuals(object = mod2, type = "structural"), breaks = 40,
     main = "mod2", xlab = expression(hat(xi)))

mod3 <- CopRegIMA(formula   = f1,
                  data      = dat1_Tropicana,
                  cdf       = "rank.n",
                  ties      = "max",
                  nboots    = 199,
                  subset    = NULL,
                  contrasts = NULL,
                  parallel  = FALSE,
                  ncores    = NULL,
                  verbose   = interactive())
summary(object = mod3)
validity(object = mod3, level = 0.05, power = 0.8)

## IMA differs from 2sCOPE only in that its first-stage regression carries no
## intercept, so the two are usually very close; the gap widens the further the
## transformed exogenous regressors sit from mean zero, for instance with
## unbalanced dummies.

mod4 <- CopRegBMW(formula   = f1,
                  data      = dat1_Tropicana,
                  cdf       = "rank.n1",
                  ties      = "max",
                  nboots    = 199,
                  subset    = NULL,
                  contrasts = NULL,
                  parallel  = FALSE,
                  ncores    = NULL,
                  verbose   = interactive())
summary(object = mod4)
validity(object = mod4, level = 0.05, power = 0.8)

## BMW inverts the order of the two operations: the first stage runs on the raw
## variables and the rank transform is applied to its residuals, where 2sCOPE
## transforms first and regresses the transformed variables on one another.
## Two consequences show up in the output.  The identification requirement
## falls on the first-stage residuals rather than on price4, so validity()
## tests those; and Corollary 3.2 makes the textbook t statistic valid for
## testing rho = 0, so summary() adds that Durbin-Hausman-Wu test next to the
## bootstrap one.
##
## cdf is fixed here in a way it is not elsewhere: Proposition 3.1 is derived
## for Rank/(n+1), so any other choice warns.

mod5 <- CopRegJAMS(formula     = f1,
                   data        = dat1_Tropicana,
                   conditional = TRUE,
                   cdf         = "ecdf.adj",
                   ties        = "max",
                   nboots      = 199,
                   subset      = NULL,
                   contrasts   = NULL,
                   parallel    = FALSE,
                   ncores      = NULL,
                   verbose     = interactive())
summary(object = mod5)
validity(object = mod5, level = 0.05, power = 0.8)

## JAMS estimates the copula structure separately per category of deal, so the
## coefficient table shows price4_cop.z1 and price4_cop.z2.  summary() reports
## a bootstrap Wald test of their joint significance and a second one asking
## whether they differ across the categories.
mod6 <- CopRegJAMS(formula     = f1,
                   data        = dat1_Tropicana,
                   conditional = FALSE,          # one common copula structure
                   cdf         = "ecdf.adj",
                   ties        = "max",
                   nboots      = 199,
                   subset      = NULL,
                   contrasts   = NULL,
                   parallel    = FALSE,
                   ncores      = NULL,
                   verbose     = interactive())
summary(object = mod6)

## 2sCOPE-np replaces the whole first stage by a nonparametric estimate of the
## conditional CDF of price4 given the other prices, feature and deal.  It
## makes the fewest assumptions of all methods here, and it costs the most: the
## cross-validated bandwidth selection is O(n^2) and, following Section 2.5 of
## the paper, it is repeated in every bootstrap replicate.  Conditioning on
## eleven exogenous regressors at n = 9,649 is not a five minute job; the call
## below therefore keeps the conditioning set small, which Section 3.1.3
## recommends anyway.
mod7 <- CopReg2sCOPEnp(formula       = logmove ~ price4 | price1 + price2 + feat,
                       data          = dat1_Tropicana,
                       condition     = NULL,
                       groups        = NULL,
                       heterogeneous = NULL,
                       demean        = NULL,
                       bwmethod      = "cv.ls",
                       bw.refit      = TRUE,
                       nboots        = 199,
                       subset        = NULL,
                       contrasts     = NULL,
                       parallel      = TRUE,     # 199 cross-validations
                       ncores        = NULL,
                       verbose       = TRUE)     # prints the expected runtime
summary(object = mod7)
validity(object = mod7, level = 0.05, power = 0.8)

## The Bayesian approach estimates the marginal CDFs jointly with everything
## else instead of plugging them in, so nothing here is a first-stage estimate
## whose uncertainty would have to be bootstrapped back in.  The cost is run
## time: the sampler is linear in n and in the number of iterations, so at
## n = 9,649 the 102,000 iterations of the paper take a while.  Section 6 goes
## through the arguments.
mod8 <- CopRegBAYES(formula    = f1,
                    data       = dat1_Tropicana,
                    iterations = 102000,
                    burnin     = 2000,
                    thin       = 100,
                    horseshoe  = TRUE,
                    prior.args = list(),
                    start      = NULL,
                    subset     = NULL,
                    contrasts  = NULL,
                    verbose    = TRUE)           # progress bar
summary(object = mod8, level = 0.95)
validity(object = mod8, chains = FALSE, power = 0.8, verbose = interactive())

## the uncorrected benchmark travels with each object, from the same bootstrap
## resamples, so the standard errors are directly comparable
mod1$ols.coefficients["price4"]
c(PG    = coef(object = mod1)["price4"],
  s2COPE = coef(object = mod2)["price4"],
  IMA   = coef(object = mod3)["price4"],
  BMW   = coef(object = mod4)["price4"],
  JAMS  = coef(object = mod5)["price4"],
  BAYES = coef(object = mod8)["price4"])


## --- all prices endogenous, no exogenous part --------------------------------

f2 <- logmove ~ price4 + price1 + price2 + price3 + price5 + price6 + price7 +
  price8 + price9 + price10

mod9 <- CopRegPG(formula   = f2,
                 data      = dat1_Tropicana,
                 cdf       = "kde.silverman",
                 ties      = "max",
                 nboots    = 199,
                 subset    = NULL,
                 contrasts = NULL,
                 parallel  = FALSE,
                 ncores    = NULL,
                 verbose   = interactive())
summary(object = mod9)

## 2sCOPE has no first stage without exogenous regressors and is redirected to
## CopRegPG() with a warning.  2sCOPE-np is redirected the same way, since
## without W the conditional CDF is the marginal one.
mod10 <- CopReg2sCOPE(formula   = f2,
                      data      = dat1_Tropicana,
                      cdf       = "rank.n",
                      ties      = "max",
                      nboots    = 199,
                      subset    = NULL,
                      contrasts = NULL,
                      parallel  = FALSE,
                      ncores    = NULL,
                      verbose   = interactive())

## BAYES is not redirected: with no exogenous regressors there is simply
## nothing to restrict in the copula correlation matrix, and the joint
## estimation of the margins and the correlations proceeds unchanged.
mod11 <- CopRegBAYES(formula    = logmove ~ price4 + price1 + price2,
                     data       = dat1_Tropicana,
                     iterations = 20000,          # short, for a look
                     burnin     = 2000,
                     thin       = 20,             # still 900 draws
                     horseshoe  = TRUE,
                     prior.args = list(),
                     start      = NULL,
                     subset     = NULL,
                     contrasts  = NULL,
                     verbose    = interactive())
summary(object = mod11, level = 0.95)


## --- adding store fixed effects (83 dummies) ---------------------------------

f3 <- logmove ~ price4 + price1 + price2 + price3 + price5 + price6 + price7 +
  price8 + price9 + price10 |
  feat + as.factor(deal) + as.factor(store)

mod12 <- CopRegPG(formula   = f3,
                  data      = dat1_Tropicana,
                  cdf       = "kde.silverman",
                  ties      = "max",
                  nboots    = 199,
                  subset    = NULL,
                  contrasts = NULL,
                  parallel  = TRUE,               # 83 dummies, 10 copula terms
                  ncores    = NULL,
                  verbose   = interactive())
summary(object = mod12)

mod13 <- CopReg2sCOPE(formula   = f3,
                      data      = dat1_Tropicana,
                      cdf       = "rank.n",
                      ties      = "max",
                      nboots    = 199,
                      subset    = NULL,
                      contrasts = NULL,
                      parallel  = TRUE,
                      ncores    = NULL,
                      verbose   = interactive())
summary(object = mod13)

mod14 <- CopRegIMA(formula   = f3,
                   data      = dat1_Tropicana,
                   cdf       = "rank.n",
                   ties      = "max",
                   nboots    = 199,
                   subset    = NULL,
                   contrasts = NULL,
                   parallel  = TRUE,
                   ncores    = NULL,
                   verbose   = interactive())
summary(object = mod14)

mod15 <- CopRegJAMS(formula     = f3,
                    data        = dat1_Tropicana,
                    conditional = TRUE,
                    cdf         = "ecdf.adj",
                    ties        = "max",
                    nboots      = 199,
                    subset      = NULL,
                    contrasts   = NULL,
                    parallel    = TRUE,
                    ncores      = NULL,
                    verbose     = interactive())
summary(object = mod15)

## 83 store dummies mean 83 further rows and columns in the copula correlation
## matrix and 83 more mass vectors, each sitting on two unique values.  That is
## the shape of the paper's own application, which carries 121 weekly dummies,
## but it is the expensive direction to grow in.


## =============================================================================
##  2. Returns to education (CPS 1988)
## =============================================================================

library(AER)
data("CPS1988")
data1 <- CPS1988
data1$lwage <- log(data1$wage)
data1$experience_sq <- data1$experience^2

f4 <- lwage ~ education + experience |
  experience_sq + parttime + smsa + ethnicity

mod1 <- CopRegPG(formula   = f4,
                 data      = data1,
                 cdf       = "kde.silverman",
                 ties      = "max",
                 nboots    = 199,
                 subset    = NULL,
                 contrasts = NULL,
                 parallel  = TRUE,                # n = 28,155
                 ncores    = NULL,
                 verbose   = interactive())
summary(object = mod1)
validity(object = mod1, level = 0.05, power = 0.8)

mod2 <- CopReg2sCOPE(formula   = f4,
                     data      = data1,
                     cdf       = "rank.n",
                     ties      = "max",
                     nboots    = 199,
                     subset    = NULL,
                     contrasts = NULL,
                     parallel  = TRUE,
                     ncores    = NULL,
                     verbose   = interactive())
summary(object = mod2)
validity(object = mod2, level = 0.05, power = 0.8)

## Both warn about education: it is recorded in whole years, 19 distinct values
## with 37.5% of the sample at a single value.  The copula transformation
## inverts an estimated CDF, and that point mass is a plateau in it.

mod3 <- CopRegIMA(formula   = f4,
                  data      = data1,
                  cdf       = "rank.n",
                  ties      = "max",
                  nboots    = 199,
                  subset    = NULL,
                  contrasts = NULL,
                  parallel  = TRUE,
                  ncores    = NULL,
                  verbose   = interactive())
summary(object = mod3)

## This is the case 2sCOPE-np was built for.  2sCOPE-np inverts the conditional
## CDF instead, which the kernel estimator of Equation 43 smooths in P as well,
## so the transformation stays well defined for counts and even binary
## regressors.  The paper's own return-to-education application is this model.
mod4 <- CopReg2sCOPEnp(formula       = f4,
                       data          = data1,
                       condition     = NULL,
                       groups        = NULL,
                       heterogeneous = NULL,
                       demean        = NULL,
                       bwmethod      = "cv.ls",
                       bw.refit      = TRUE,
                       nboots        = 199,
                       subset        = NULL,
                       contrasts     = NULL,
                       parallel      = TRUE,
                       ncores        = NULL,
                       verbose       = TRUE)
summary(object = mod4)
validity(object = mod4, level = 0.05, power = 0.8)

## BAYES meets the same tie problem from the other end.  Its margins are
## probability masses on the unique values, so 19 distinct years of education
## is 19 masses rather than a plateau in a plug-in CDF, and the mass at the
## modal value is a parameter with a posterior like any other.  plot() shows
## it: the estimated CDF has a visible step there, and a credible band that
## widens where the data are thin.
mod5 <- CopRegBAYES(formula    = f4,
                    data       = data1,
                    iterations = 102000,
                    burnin     = 2000,
                    thin       = 100,
                    horseshoe  = TRUE,
                    prior.args = list(),
                    start      = NULL,
                    subset     = NULL,
                    contrasts  = NULL,
                    verbose    = TRUE)
summary(object = mod5, level = 0.95)
plot(x = mod5, which = "education", type = "cdf", level = 0.95, ask = FALSE)
validity(object = mod5, chains = FALSE, power = 0.8, verbose = interactive())

## as.factor(experience_sq) produces 63 dummies, four of them with fewer than
## five observations, and it nearly spans experience itself.  The estimate for
## experience becomes unstable; the omega column in summary() shows why.
mod6 <- CopRegPG(formula   = lwage ~ education + experience |
                             as.factor(experience_sq) + as.factor(parttime) +
                             smsa + ethnicity,
                 data      = data1,
                 cdf       = "kde.silverman",
                 ties      = "max",
                 nboots    = 199,
                 subset    = NULL,
                 contrasts = NULL,
                 parallel  = TRUE,
                 ncores    = NULL,
                 verbose   = interactive())
summary(object = mod6)


## =============================================================================
##  3. Carseats
## =============================================================================

library(ISLR)
data("Carseats")
dat3 <- Carseats

dat3$lsales     <- log(dat3$Sales)
dat3$lprice     <- log(dat3$Price)
dat3$lcompprice <- log(dat3$CompPrice)
dat3 <- subset(dat3, is.finite(log(Sales)))

f5 <- lsales ~ lprice + lcompprice |
  ShelveLoc + Income + Advertising + Population + Age + Education + Urban + US

mod1 <- CopRegPG(formula   = f5,
                 data      = dat3,
                 cdf       = "kde.silverman",
                 ties      = "max",
                 nboots    = 299,                 # n = 400, so more replicates
                 subset    = NULL,
                 contrasts = NULL,
                 parallel  = FALSE,
                 ncores    = NULL,
                 verbose   = interactive())
summary(object = mod1)

## n = 400 falls in the range where Becker, Proksch & Ringle (2022) require
## strong nonnormality; validity() reports their thresholds next to the KS
## criterion of Yang, Qian & Xie (2025).  power = is the power the thresholds
## are read at, level = the significance level of the normality tests.
validity(object = mod1, level = 0.05, power = 0.8)
validity(object = mod1, level = 0.05, power = 0.9)
validity(object = mod1, level = 0.01, power = 0.8)

mod2 <- CopReg2sCOPE(formula   = f5,
                     data      = dat3,
                     cdf       = "rank.n",
                     ties      = "max",
                     nboots    = 299,
                     subset    = NULL,
                     contrasts = NULL,
                     parallel  = FALSE,
                     ncores    = NULL,
                     verbose   = interactive())
summary(object = mod2)
validity(object = mod2, level = 0.05, power = 0.8)

mod3 <- CopRegIMA(formula   = f5,
                  data      = dat3,
                  cdf       = "rank.n",
                  ties      = "max",
                  nboots    = 299,
                  subset    = NULL,
                  contrasts = NULL,
                  parallel  = FALSE,
                  ncores    = NULL,
                  verbose   = interactive())
summary(object = mod3)
validity(object = mod3, level = 0.05, power = 0.8)

## conditional = TRUE takes all three factors, so 3 x 2 x 2 = 12 cells with two
## copula terms each, which is a lot for n = 400
mod4 <- CopRegJAMS(formula     = f5,
                   data        = dat3,
                   conditional = TRUE,
                   cdf         = "ecdf.adj",
                   ties        = "max",
                   nboots      = 299,
                   subset      = NULL,
                   contrasts   = NULL,
                   parallel    = FALSE,
                   ncores      = NULL,
                   verbose     = interactive())
summary(object = mod4)

## conditioning on ShelveLoc alone gives three cells; Urban and US stay in the
## model as ordinary controls
mod5 <- CopRegJAMS(formula     = f5,
                   data        = dat3,
                   conditional = "ShelveLoc",     # only this factor
                   cdf         = "ecdf.adj",
                   ties        = "max",
                   nboots      = 299,
                   subset      = NULL,
                   contrasts   = NULL,
                   parallel    = FALSE,
                   ncores      = NULL,
                   verbose     = interactive())
summary(object = mod5)
validity(object = mod5, level = 0.05, power = 0.8)

## The Bayesian version of the same model.  At n = 400 the default 102,000
## iterations run in a couple of minutes.
mod6 <- CopRegBAYES(formula    = f5,
                    data       = dat3,
                    iterations = 102000,
                    burnin     = 2000,
                    thin       = 100,
                    horseshoe  = TRUE,
                    prior.args = list(),
                    start      = NULL,
                    subset     = NULL,
                    contrasts  = NULL,
                    verbose    = TRUE)
summary(object = mod6, level = 0.95)
validity(object = mod6, chains = FALSE, power = 0.8, verbose = interactive())

## The whole toolbox on one coefficient.  The frequentist estimators report a
## point estimate with a bootstrap standard error, the Bayesian one a posterior
## mean; they are not the same object, and a credible interval is not a
## confidence interval, but they answer the same question.
c(PG     = coef(object = mod1)["lprice"],
  s2COPE = coef(object = mod2)["lprice"],
  IMA    = coef(object = mod3)["lprice"],
  JAMS   = coef(object = mod5)["lprice"],
  BAYES  = coef(object = mod6)["lprice"])

## subset = takes a logical vector, exactly as in lm().  Pick one that does
## not empty a factor level of the model: subsetting to a single level of US
## while US is still a regressor leaves an all-zero dummy, and the estimator
## says so rather than silently dropping it.
mod7 <- CopRegPG(formula   = f5,
                 data      = dat3,
                 cdf       = "kde.silverman",
                 ties      = "max",
                 nboots    = 299,
                 subset    = dat3$Income > 40,   # a subsample
                 contrasts = NULL,
                 parallel  = FALSE,
                 ncores    = NULL,
                 verbose   = interactive())
summary(object = mod7)

## contrasts = is passed to model.matrix(), so the coding of the factors is
## under your control
mod8 <- CopRegPG(formula   = f5,
                 data      = dat3,
                 cdf       = "kde.silverman",
                 ties      = "max",
                 nboots    = 299,
                 subset    = NULL,
                 contrasts = list(ShelveLoc = "contr.sum"),   # sum coding
                 parallel  = FALSE,
                 ncores    = NULL,
                 verbose   = interactive())
summary(object = mod8)

## factors work either way, as a factor column or via as.factor() in the
## formula; the fit is identical, only the column order changes
dat3$ShelveLoc_num <- as.numeric(dat3$ShelveLoc)

mod9 <- CopRegPG(formula   = lsales ~ lprice + lcompprice |
                             Income + Advertising + Population + Age +
                             Education + as.factor(ShelveLoc_num) +
                             as.factor(Urban) + as.factor(US),
                 data      = dat3,
                 cdf       = "kde.silverman",
                 ties      = "max",
                 nboots    = 299,
                 subset    = NULL,
                 contrasts = NULL,
                 parallel  = FALSE,
                 ncores    = NULL,
                 verbose   = interactive())
summary(object = mod9)


## =============================================================================
##  4. Varying the arguments on a single model
## =============================================================================

## Interactions and polynomials follow the formula like anything else: written
## before the "|" they are endogenous and get their own copula term, written
## after it they are exogenous and get none.  The rule is the same in every
## estimator, including BAYES and PANEL, where such a term gets its own row and
## column in the copula correlation matrix rather than an added regressor.

CopRegPG(formula   = lsales ~ lprice + lprice:Advertising |
                     Advertising + Income,
         data      = dat3,
         cdf       = "kde.silverman",
         ties      = "max",
