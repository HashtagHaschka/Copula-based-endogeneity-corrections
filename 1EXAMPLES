## =============================================================================
##  6. The Bayesian approach
## =============================================================================
##
##  Everything the other estimators do in stages happens here in one.  The
##  marginal CDFs are not plugged in but are unknown parameters -- probability
##  masses on the uniquely observed values of each regressor -- and they are
##  drawn along with the regression coefficients, the error variance and the
##  full copula correlation matrix.  Nothing is estimated a priori, so there is
##  no plug-in uncertainty to bootstrap back in; the posterior carries it.

f7 <- lsales ~ lprice + lcompprice |
  ShelveLoc + Income + Advertising + Age

bay1 <- CopRegBAYES(formula    = f7,
                    data       = dat3,
                    iterations = 102000,
                    burnin     = 2000,
                    thin       = 100,
                    horseshoe  = TRUE,
                    prior.args = list(),
                    start      = NULL,
                    subset     = NULL,
                    contrasts  = NULL,
                    verbose    = TRUE)

## summary() reports the posterior mean, the posterior median, the posterior
## standard deviation and a credible interval, for the coefficients, for the
## structural error variance and for the endogeneity correlations.  The
## correlations between the exogenous regressors and the error do not appear:
## they are held at zero, which is what makes those regressors exogenous, and
## the block-recursive sampler holds them there exactly rather than
## approximately.
summary(object = bay1, level = 0.95)
summary(object = bay1, level = 0.90)
summary(object = bay1, level = 0.99)

## The correlation of interest is rho(lprice*, xi*), and summary() shows only
## that one and its counterpart for lcompprice.  The correlations among the
## regressors are estimated jointly too, but they are nuisance parameters and
## there are many of them, so they stay on the object rather than in the
## output.  Naming follows the rest of the toolbox: P for the endogenous
## regressors, W for the exogenous ones, xi for the structural error, and a
## star for the normal score.  The paper writes z, x and e for the same three.
head(bay1$Sigma.draws[, "rho(lprice*, xi*)"])
mean(bay1$Sigma.draws[, "rho(lprice*, xi*)"] > 0)
bay1$rho.names                # the endogeneity correlations, by name
colnames(bay1$Sigma.draws)    # all of them, free and restricted alike


## --- how long to run it ------------------------------------------------------
##
## The defaults are the setting of the paper's simulations: 102,000 iterations,
## the first 2,000 discarded and every 100th of the rest retained, leaving
## 1,000 draws.  The empirical application runs ten times as long with
## thin = 10,000 for the same 1,000 draws, on the argument that a chain cannot
## be too long.  Thinning happens while sampling, so only the retained draws
## are ever held in memory: keeping every iterate and thinning afterwards would
## need about 21 GB for that application.

bay2 <- CopRegBAYES(formula    = f7,
                    data       = dat3,
                    iterations = 20000,           # short
                    burnin     = 2000,
                    thin       = 20,
                    horseshoe  = TRUE,
                    prior.args = list(),
                    start      = NULL,
                    subset     = NULL,
                    contrasts  = NULL,
                    verbose    = TRUE)

bay3 <- CopRegBAYES(formula    = f7,
                    data       = dat3,
                    iterations = 1002000,         # the paper's application
                    burnin     = 2000,
                    thin       = 10000,
                    horseshoe  = TRUE,
                    prior.args = list(),
                    start      = NULL,
                    subset     = NULL,
                    contrasts  = NULL,
                    verbose    = TRUE)


## --- priors ------------------------------------------------------------------
##
## horseshoe = TRUE is the prior of Equation (5) in the marginalised form of
## Equation (6), on every coefficient including the intercept, and is the
## specification the paper settles on.  FALSE puts an independent normal on
## each coefficient with its own inverse Gamma variance, drawn by a conjugate
## Gibbs step.

bay4 <- CopRegBAYES(formula    = f7,
                    data       = dat3,
                    iterations = 102000,
                    burnin     = 2000,
                    thin       = 100,
                    horseshoe  = FALSE,           # normal with IG variance
                    prior.args = list(),
                    start      = NULL,
                    subset     = NULL,
                    contrasts  = NULL,
                    verbose    = TRUE)
c(horseshoe = coef(object = bay1)["lprice"],
  normal    = coef(object = bay4)["lprice"])

## Every hyperparameter is reachable through prior.args and defaults to the
## paper.  The full list, with the defaults it would use anyway:
##
##   a, b            inverse Gamma prior on sigma^2, Equation (7)
##   a_phi, b_phi    inverse Gamma prior on the coefficient variances
##                   (horseshoe = FALSE only)
##   nu1, Psi1       inverse Wishart prior on Sigma_xx
##   nu2, Psi2       inverse Wishart prior on Omega
##   a_e, b_e        inverse Gamma prior on sigma_e^2
##   M0, V0          matrix normal prior on C = [B_x | beta_e]
bay1$prior.args

## Read the two dimensions off a fitted model rather than counting by hand:
## ShelveLoc contributes two dummy columns, not one.
K <- length(bay1$endo.names)   # endogenous columns
L <- length(bay1$exog.names)   # exogenous columns, intercept excluded

bay5 <- CopRegBAYES(formula    = f7,
                    data       = dat3,
                    iterations = 102000,
                    burnin     = 2000,
                    thin       = 100,
                    horseshoe  = TRUE,
                    prior.args = list(a     = 0.001,
                                      b     = 0.001,
                                      a_phi = 0.001,
                                      b_phi = 0.001,
                                      nu1   = L + 2,
                                      Psi1  = diag(L),
                                      nu2   = K + 2,
                                      Psi2  = diag(K),
                                      a_e   = 0.001,
                                      b_e   = 0.001,
                                      M0    = matrix(0, K, L + 1L),
                                      V0    = diag(L + 1L)),
                    start      = NULL,
                    subset     = NULL,
                    contrasts  = NULL,
                    verbose    = TRUE)

## Starting values follow Web Appendix D: OLS for the coefficients and the
## error variance, the identity for the correlation matrix, one Dir(1) draw per
## regressor for the masses.  Any of them can be replaced; the full list is
## coefficients, sigma2, Sigma, lambda and phi2.
bay6 <- CopRegBAYES(formula    = lsales ~ lprice | Income + Advertising + Age,
                    data       = dat3,
                    iterations = 20000,
                    burnin     = 2000,
                    thin       = 20,
                    horseshoe  = TRUE,
                    prior.args = list(),
                    start      = list(coefficients = rep(0, 5),
                                      sigma2       = 1,
                                      Sigma        = diag(5),
                                      lambda       = NULL,
                                      phi2         = rep(1000, 5)),
                    subset     = NULL,
                    contrasts  = NULL,
                    verbose    = TRUE)


## --- looking at the chain ----------------------------------------------------
##
## A model of any size has far more parameters than fit on a screen, so plot()
## takes which = to select them, by name or by position.  NULL, the default,
## is the endogenous regressors, which are what the correction is about.
## ask = NULL asks between plots only when there is more than one and the
## device is interactive.

plot(x = bay1, which = NULL, type = "trace",   level = 0.95, ask = NULL)
plot(x = bay1, which = NULL, type = "acf",     level = 0.95, ask = NULL)
plot(x = bay1, which = NULL, type = "pacf",    level = 0.95, ask = NULL)
plot(x = bay1, which = NULL, type = "density", level = 0.95, ask = NULL)

plot(x = bay1, which = c("lprice", "sigma2", "rho(lprice*, xi*)"),
     type = "trace", level = 0.95, ask = TRUE)
plot(x = bay1, which = 1:3, type = "density", level = 0.95, ask = FALSE)

colnames(bay1$draws)          # everything that can be named in which =

## type = "cdf" is different in kind.  It shows the marginal distribution of a
## regressor as the model estimates it -- the cumulative sums of the
## probability masses -- with a pointwise credible band across the draws.  That
## object does not exist in the frequentist estimators, where the CDF is a
## fixed plug-in with no uncertainty attached to it at all.
plot(x = bay1, which = NULL, type = "cdf", level = 0.95, ask = NULL)
plot(x = bay1, which = c("lprice", "Income"), type = "cdf",
     level = 0.90, ask = FALSE)
names(bay1$lambda.draws)      # everything that has an estimated margin

## The raw draws are there for anything the methods do not cover.
dim(bay1$draws)
head(bay1$coefficient.draws)
head(bay1$sigma2.draws)
bay1$acceptance


## --- checks ------------------------------------------------------------------
##
## validity() does two things at once.  The identification side is the same
## question as everywhere: without a nonnormal endogenous regressor E(e|z) is
## linear and the copula cannot separate it from the regression.  The
## convergence side is specific to MCMC -- Geweke, effective sample size and
## the lag-one autocorrelation, all computed from the chain that already
## exists.

validity(object = bay1, chains = FALSE, power = 0.8, verbose = interactive())

## Gelman-Rubin is the exception: it needs several chains from dispersed
## starts, which means running the sampler again, once per chain.  The
## dispersed starts follow Web Appendix E -- normal around the OLS estimates
## for the coefficients, LKJ for the correlation matrix, Dir(1) for the masses.
## chains = TRUE uses four; a number sets it.  Gelman et al. read convergence
## as GR <= 1.1.
v <- validity(object = bay1, chains = 4, power = 0.8, verbose = TRUE)
v$gelman.rubin
v$convergence
v$endogeneity
v$nonnormality
v$thresholds
v$acceptance


## =============================================================================
##  7. Panel data
## =============================================================================
##
##  CopRegPANEL() is a separate model class, the way plm is separate from lm.
##  It is estimated by maximum likelihood rather than augmented least squares,
##  it needs an index, and it is deliberately not reachable through copreg().
##
##  The orange juice data are a store by week panel, so the same data used
##  above can be looked at either way.

dat5 <- orangeJuice[[1]]
dat5 <- dat5[dat5$brand == 4, ]
pcols <- grep("^price", names(dat5), value = TRUE)
dat5[pcols] <- lapply(dat5[pcols], log)

## 83 stores, 87 to 121 weeks each
pan1 <- CopRegPANEL(formula   = logmove ~ price4 |
                                price1 + price2 + price3 + feat +
                                as.factor(deal),
                    data      = dat5,
                    index     = c("store", "week"),
                    cdf       = "kde.plugin",
                    ties      = "max",
                    intercept = FALSE,
                    nboots    = 199,
                    method    = "BFGS",
                    start     = NULL,
                    maxit     = 5000L,
                    subset    = NULL,
                    contrasts = NULL,
                    parallel  = FALSE,
                    ncores    = NULL,
                    verbose   = interactive())
summary(object = pan1)

## validity() carries the checkpoints that survive the transformation: the
## nonnormality thresholds of Becker, Proksch & Ringle (2022), whose Study 3
## covers fixed-effects panels and finds the cross-sectional thresholds apply
## once total n is the reference; the normality of the transformed error, which
## Equation 12 assumes outright; and the standard errors against the plain
## within estimator on the same resamples, for which Haschka (2022) reads a
## factor of five to ten as a clear sign the model is not identified.
##
## The uncorrelatedness assumption is not among them: modelling the correlation
## between endogenous and exogenous regressors rather than assuming it away is
## the point of this estimator.
validity(object = pan1, level = 0.05, power = 0.8)

## the uncorrected benchmark travels with the object, from the same resamples
pan1$within.coefficients
pan1$within.std.error
pan1$se.ratio

## Both scales are available everywhere.  structural = TRUE is the model as
## written down, y = alpha_i + x'beta + z'delta + e, on the original rows.
## structural = FALSE is the transformed model that maximum likelihood actually
## fits, and those residuals are the ones the likelihood treats as normal, so
## they are what to inspect when checking that assumption.
hist(residuals(object = pan1, structural = TRUE), breaks = 40,
     main = "structural")
hist(residuals(object = pan1, structural = FALSE), breaks = 40,
     main = "transformed")
qqnorm(residuals(object = pan1, structural = FALSE))
qqline(residuals(object = pan1, structural = FALSE))

fitted(object = pan1, structural = TRUE)
fitted(object = pan1, structural = FALSE)
fixef(object = pan1)                                     # the effects alpha_i
predict(object = pan1, newdata = head(dat5, 5), structural = TRUE)
coef(object = pan1)
vcov(object = pan1)
confint(object = pan1, parm = names(coef(object = pan1)), level = 0.95,
        type = "normal")
confint(object = pan1, parm = names(coef(object = pan1)), level = 0.95,
        type = "percentile")
logLik(object = pan1)
AIC(object = pan1)
BIC(object = pan1)

## A lagged dependent variable is written straight into the formula; lag(),
## lead() and diff() are panel aware and never reach across a store boundary.
## It belongs in the endogenous part: the transformation does not make it
## predetermined, since it averages over future values of the lagged series,
## which contain the current error.
pan2 <- CopRegPANEL(formula   = logmove ~ lag(logmove) + price4 |
                                price1 + price2 + feat + as.factor(deal),
                    data      = dat5,
                    index     = c("store", "week"),
                    cdf       = "kde.plugin",
                    ties      = "max",
                    intercept = FALSE,
                    nboots    = 199,
                    method    = "BFGS",
                    start     = NULL,
                    maxit     = 5000L,
                    subset    = NULL,
                    contrasts = NULL,
                    parallel  = TRUE,
                    ncores    = NULL,
                    verbose   = interactive())
summary(object = pan2)

## higher lags and interactions work as they would in lm()
pan3 <- CopRegPANEL(formula   = logmove ~ price4 + price4:feat |
                                price1 + lag(price1) + feat + as.factor(deal),
                    data      = dat5,
                    index     = c("store", "week"),
                    cdf       = "kde.plugin",
                    ties      = "max",
                    intercept = FALSE,
                    nboots    = 199,
                    method    = "BFGS",
                    start     = NULL,
                    maxit     = 5000L,
                    subset    = NULL,
                    contrasts = NULL,
                    parallel  = FALSE,
                    ncores    = NULL,
                    verbose   = interactive())
summary(object = pan3)

## Time dummies stay in the model but are dropped from the copula: they are
## deterministic functions of the period and identical across panels, so after
## the transformation a full set of them is one dimension short.  The message
## says which columns were affected.
pan4 <- CopRegPANEL(formula   = logmove ~ price4 |
                                price1 + feat + as.factor(week),
                    data      = dat5,
                    index     = c("store", "week"),
                    cdf       = "kde.plugin",
                    ties      = "max",
                    intercept = FALSE,
                    nboots    = 99,
                    method    = "BFGS",
                    start     = NULL,
                    maxit     = 5000L,
                    subset    = NULL,
                    contrasts = NULL,
                    parallel  = FALSE,
                    ncores    = NULL,
                    verbose   = interactive())

## An intercept is off by default.  A fixed-effects transformation removes
## anything time invariant, so the structural intercept is gone with the
## individual effects; intercept = TRUE adds a free constant to the transformed
## regression, which is what the original implementation offered.  It is
## collinear with a full set of time dummies.  summary() says which of the two
## the model carries.
pan5 <- CopRegPANEL(formula   = logmove ~ price4 | price1 + feat,
                    data      = dat5,
                    index     = c("store", "week"),
                    cdf       = "kde.plugin",
                    ties      = "max",
                    intercept = TRUE,             # free constant
                    nboots    = 99,
                    method    = "BFGS",
                    start     = NULL,
                    maxit     = 5000L,
                    subset    = NULL,
                    contrasts = NULL,
                    parallel  = FALSE,
                    ncores    = NULL,
                    verbose   = interactive())
summary(object = pan5)

## cdf defaults to "kde.plugin", a Gaussian kernel with the Polansky & Baker
## plug-in bandwidth -- the estimator the original code used, reimplemented
## without the ks dependency.  The paper itself integrates the density
## estimator of Ngom et al. (2018) and allows conventional kernel estimation or
## the empirical CDF as alternatives, so the whole menu is open here too.
pan6 <- CopRegPANEL(formula   = logmove ~ price4 | price1 + feat,
                    data      = dat5,
                    index     = c("store", "week"),
                    cdf       = "ecdf.adj",
                    ties      = "max",
                    intercept = FALSE,
                    nboots    = 99,
                    method    = "BFGS",
                    start     = NULL,
                    maxit     = 5000L,
                    subset    = NULL,
                    contrasts = NULL,
                    parallel  = FALSE,
                    ncores    = NULL,
                    verbose   = interactive())

## The optimiser tries BFGS and falls back to Nelder-Mead by itself; you can
## also force the derivative-free route from the start, raise the iteration
## cap, or hand it your own starting values.
pan7 <- CopRegPANEL(formula   = logmove ~ price4 | price1 + feat,
                    data      = dat5,
                    index     = c("store", "week"),
                    cdf       = "kde.plugin",
                    ties      = "max",
                    intercept = FALSE,
                    nboots    = 99,
                    method    = "Nelder-Mead",
                    start     = NULL,
                    maxit     = 20000L,
                    subset    = NULL,
                    contrasts = NULL,
                    parallel  = FALSE,
                    ncores    = NULL,
                    verbose   = interactive())

## The same formula rule applies here, except that there is no augmented
## regression: an endogenous term gets its own rho in the copula correlation
## matrix rather than an added regressor.
pan8 <- CopRegPANEL(formula   = logmove ~ price4 + price4:feat | price1 + feat,
                    data      = dat5,
                    index     = c("store", "week"),
                    cdf       = "kde.plugin",
