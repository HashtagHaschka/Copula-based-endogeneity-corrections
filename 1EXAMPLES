                      subset        = NULL,
                      contrasts     = NULL,
                      parallel      = FALSE,
                      ncores        = NULL,
                      verbose       = interactive())

## groups = estimates the conditional CDF separately within each joint category
## of the named variables instead of smoothing them with their own kernel
## (Section 3.1.5).  One copula coefficient as before.
