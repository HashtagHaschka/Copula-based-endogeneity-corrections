                      bw.refit      = TRUE,
                      nboots        = 99,
                      subset        = NULL,
                      contrasts     = NULL,
                      parallel      = FALSE,
                      ncores        = NULL,
                      verbose       = interactive())
summary(object = np1)

## condition = names the conditioning variables explicitly.  Section 3.1.3
## recommends dropping covariates known to be irrelevant for P: every further
## variable thins out the local neighbourhood the estimator averages over.
np2 <- CopReg2sCOPEnp(formula       = lsales ~ lprice |
                                      Income + Advertising + Population +
                                      Age + Education,
